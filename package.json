{
  "name": "linkedin-lead-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Tracks LinkedIn DM lead status (sent, delivered, opened, replied, follow-up due) and writes it to a Google Sheet CRM.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "log-webhooks": "tsx scripts/log-webhooks.ts",
    "setup-sheet": "tsx scripts/setup-sheet.ts",
    "sync-leads": "tsx scripts/sync-leads.ts",
    "run-scheduler": "tsx scripts/run-scheduler.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "googleapis": "^178.0.0",
    "node-cron": "^4.6.0",
    "openai": "^6.49.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
