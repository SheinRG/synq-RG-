# Copy to .env and fill in. Never commit .env.

# Unipile (https://dashboard.unipile.com)
# DSN looks like api8.unipile.com:13851 (no https://)
UNIPILE_DSN=apiX.unipile.com:PORT
UNIPILE_API_KEY=
# The connected LinkedIn account id from the Unipile dashboard
UNIPILE_ACCOUNT_ID=

# Shared secret. Unipile sends it back in the WEBHOOK_AUTH_HEADER header on every webhook.
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_AUTH_HEADER=Unipile-Auth
# Public URL of this server, used by `npm run register-webhook` (for example your ngrok URL)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# LLM used to label replies. Any OpenAI compatible API works.
# xAI Grok: base URL https://api.x.ai/v1. Check current model ids with `npm run check-llm`.
# Groq instead: LLM_BASE_URL=https://api.groq.com/openai/v1 and LLM_MODEL=openai/gpt-oss-20b
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.20-0309-non-reasoning

# Google Sheets CRM
# Either a path to the service account key file, or the raw JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
SHEET_ID=

# Status rules
NOT_REPLIED_AFTER_DAYS=3
MAX_FOLLOWUPS=2
# DEMO_MODE=true treats NOT_REPLIED_AFTER_DAYS as minutes and runs the follow-up check every minute
DEMO_MODE=false

PORT=3000
DATABASE_PATH=./data/tracker.db
# Set to true to also dump every raw webhook body to logs/webhooks.ndjson
LOG_WEBHOOKS=false
